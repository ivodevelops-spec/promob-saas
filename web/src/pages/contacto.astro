---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import Alert from "../components/Alert.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Icon from "../components/Icon.astro";

const countries = [
  { value: "", label: "Seleccione su país" },
  { value: "AR", label: "Argentina" },
  { value: "UY", label: "Uruguay" },
  { value: "CL", label: "Chile" },
  { value: "PY", label: "Paraguay" },
  { value: "OT", label: "Otro país" },
];
---

<Layout
  title="Contacto — PROMOB"
  description="Escríbanos por WhatsApp o complete el formulario. El equipo local responde en español y acompaña cada consulta."
  canonical="/contacto/"
  current="contacto"
>
  <section class="section">
    <div class="container contacto-grid">
      <div class="contacto-intro">
        <h1>Contacto</h1>
        <p class="page-sub">
          ¿Tiene dudas sobre un producto, una compra o su suscripción?
          Escríbanos por WhatsApp o complete el formulario: le respondemos en
          español, en el día.
        </p>
        <WhatsAppButton label="Escribinos por WhatsApp" size="lg" />
        <ul class="contacto-datos">
          <li>
            <span class="contacto-datos__label">WhatsApp</span>
            <a
              class="contacto-datos__link"
              href="https://wa.me/5491150993627"
              target="_blank"
              rel="noopener noreferrer"
            >
              +54 9 11 5099-3627
            </a>
          </li>
          <li>
            <span class="contacto-datos__label">Horario de atención</span>
            Lunes a viernes, de 9 a 18 h (hora de Argentina).
          </li>
        </ul>
      </div>

      <Card padding="lg" class="contacto-card">
        <h2 class="contacto-card__title">Envíenos su consulta</h2>

        <div id="form-success" hidden>
          <Alert variant="success" title="Mensaje enviado">
            Gracias por escribirnos. Le responderemos a su email dentro de las
            24 horas hábiles.
          </Alert>
        </div>

        <div class="form-error" id="form-error" hidden>
          <Alert variant="danger" title="No pudimos enviar su mensaje">
            Intente nuevamente en unos minutos. Si el problema persiste,
            escríbanos por WhatsApp.
          </Alert>
          <WhatsAppButton label="Escribir por WhatsApp" variant="outline" full />
        </div>

        <form id="contact-form" novalidate>
          <!-- Honeypot anti-spam: los usuarios reales nunca lo completan. -->
          <div class="hp-field" aria-hidden="true">
            <label for="hp-website">No completar este campo</label>
            <input
              id="hp-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="field">
            <label class="field__label" for="nombre">
              Nombre y apellido <span aria-hidden="true"> *</span>
            </label>
            <input
              class="field__control"
              id="nombre"
              name="name"
              type="text"
              autocomplete="name"
              aria-required="true"
              placeholder="Ej.: Ana Pérez"
            />
            <p class="form-err" id="nombre-error" hidden>
              <Icon name="alert-triangle" size={14} />
              <span>Ingrese su nombre y apellido.</span>
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="email">
              Email <span aria-hidden="true"> *</span>
            </label>
            <input
              class="field__control"
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              aria-required="true"
              placeholder="nombre@empresa.com"
            />
            <p class="form-err" id="email-error" hidden>
              <Icon name="alert-triangle" size={14} />
              <span>Ingrese un email válido.</span>
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="empresa">Empresa</label>
            <input
              class="field__control"
              id="empresa"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder="Opcional"
            />
          </div>

          <div class="field">
            <label class="field__label" for="pais">
              País <span aria-hidden="true"> *</span>
            </label>
            <div class="field__select-wrap">
              <select
                class="field__control field__select"
                id="pais"
                name="country"
                aria-required="true"
              >
                {countries.map((country) => (
                  <option value={country.value}>{country.label}</option>
                ))}
              </select>
              <span class="field__chevron" aria-hidden="true"></span>
            </div>
            <p class="form-err" id="pais-error" hidden>
              <Icon name="alert-triangle" size={14} />
              <span>Seleccione su país.</span>
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="mensaje">
              Mensaje <span aria-hidden="true"> *</span>
            </label>
            <textarea
              class="field__control field__textarea"
              id="mensaje"
              name="message"
              rows="5"
              aria-required="true"
              placeholder="Cuéntenos en qué podemos ayudarlo"
            ></textarea>
            <p class="form-err" id="mensaje-error" hidden>
              <Icon name="alert-triangle" size={14} />
              <span>Escriba su consulta (mínimo 10 caracteres).</span>
            </p>
          </div>

          <div class="contacto-card__actions">
            <Button type="submit" variant="primary" full>Enviar mensaje</Button>
            <p class="contacto-card__note">
              Al enviar, acepta que usemos sus datos solo para responderle
              (ver <a class="contacto-card__link" href="/legales/privacidad/">privacidad</a>).
            </p>
          </div>
        </form>
      </Card>
    </div>
  </section>
</Layout>

<style>
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contacto-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
      column-gap: var(--space-12);
    }
  }

  .page-sub {
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
    max-width: 52ch;
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--ink-500);
  }

  .contacto-datos {
    list-style: none;
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-body);
    color: var(--ink-700);
  }

  .contacto-datos__label {
    display: block;
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .contacto-datos__link {
    color: var(--brand-700);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .contacto-datos__link:hover {
    text-decoration: underline;
  }

  .contacto-card__title {
    margin-bottom: var(--space-4);
    font-size: var(--text-h3);
    color: var(--brand-900);
  }

  .contacto-card__actions {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contacto-card__note {
    font-size: var(--text-micro);
    color: var(--ink-400);
  }

  .contacto-card__link {
    color: var(--brand-700);
    text-decoration: none;
  }

  .contacto-card__link:hover {
    text-decoration: underline;
  }

  /* ---- Campos (mismos tokens que el resto del sitio) ---- */
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .field__label {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--ink-700);
  }

  .field__control {
    width: 100%;
    min-height: 44px;
    padding: 10px var(--space-4);
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    font-size: var(--text-body);
    color: var(--ink-900);
    transition: border-color 150ms ease;
  }

  .field__control::placeholder {
    color: var(--ink-400);
  }

  .field__control:focus {
    outline: 2px solid var(--brand-700);
    outline-offset: 2px;
    border-color: var(--brand-700);
  }

  .field__control--error,
  .field__control--error:focus {
    border: 2px solid var(--danger-fg);
    outline-color: var(--danger-fg);
  }

  .field__select-wrap {
    position: relative;
  }

  .field__select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: var(--space-12);
    cursor: pointer;
  }

  .field__chevron {
    position: absolute;
    top: 50%;
    right: var(--space-4);
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-500);
    border-bottom: 2px solid var(--ink-500);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-err {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--danger-fg);
  }

  /* Honeypot: invisible para personas, presente para bots. */
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .form-error {
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>

<script>
  // Formulario de contacto con honeypot y validación en línea. El POST va a
  // /api/contact (contrato-api.md). Si la API no responde, se muestra un
  // estado de error amable con alternativa por WhatsApp.

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const successBox = document.getElementById("form-success");
  const errorBox = document.getElementById("form-error");

  const $ = <T extends HTMLElement>(id: string): T =>
    document.getElementById(id) as T;

  const fields = {
    nombre: $<HTMLInputElement>("nombre"),
    email: $<HTMLInputElement>("email"),
    empresa: $<HTMLInputElement>("empresa"),
    pais: $<HTMLSelectElement>("pais"),
    mensaje: $<HTMLTextAreaElement>("mensaje"),
    honeypot: $<HTMLInputElement>("hp-website"),
  };

  const errors = {
    nombre: $<HTMLElement>("nombre-error"),
    email: $<HTMLElement>("email-error"),
    pais: $<HTMLElement>("pais-error"),
    mensaje: $<HTMLElement>("mensaje-error"),
  };

  function setFieldError(
    field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    errorEl: HTMLElement | null,
    message: string | null,
  ): void {
    if (!errorEl) return;
    const hasError = message !== null;
    errorEl.hidden = !hasError;
    if (hasError && errorEl.querySelector("span")) {
      errorEl.querySelector("span")!.textContent = message;
    }
    field.classList.toggle("field__control--error", hasError);
    if (hasError) {
      field.setAttribute("aria-invalid", "true");
      field.setAttribute("aria-describedby", errorEl.id);
    } else {
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
    }
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function validate(): boolean {
    let ok = true;
    const nombre = fields.nombre.value.trim();
    const email = fields.email.value.trim();
    const pais = fields.pais.value;
    const mensaje = fields.mensaje.value.trim();

    if (nombre.length < 3) {
      setFieldError(fields.nombre, errors.nombre, "Ingrese su nombre y apellido.");
      ok = false;
    } else {
      setFieldError(fields.nombre, errors.nombre, null);
    }

    if (!EMAIL_RE.test(email)) {
      setFieldError(fields.email, errors.email, "Ingrese un email válido.");
      ok = false;
    } else {
      setFieldError(fields.email, errors.email, null);
    }

    if (!pais) {
      setFieldError(fields.pais, errors.pais, "Seleccione su país.");
      ok = false;
    } else {
      setFieldError(fields.pais, errors.pais, null);
    }

    if (mensaje.length < 10) {
      setFieldError(fields.mensaje, errors.mensaje, "Escriba su consulta (mínimo 10 caracteres).");
      ok = false;
    } else {
      setFieldError(fields.mensaje, errors.mensaje, null);
    }

    return ok;
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    errorBox.hidden = true;

    // Honeypot: si un bot completó el campo, fingimos éxito y no enviamos nada.
    if (fields.honeypot.value !== "") {
      form.hidden = true;
      successBox.hidden = false;
      return;
    }

    if (!validate()) return;

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);

    void fetch("/api/contact", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: fields.nombre.value.trim(),
        email: fields.email.value.trim(),
        company: fields.empresa.value.trim(),
        country: fields.pais.value,
        message: fields.mensaje.value.trim(),
      }),
      signal: controller.signal,
    })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.hidden = true;
        successBox.hidden = false;
      })
      .catch(() => {
        errorBox.hidden = false;
        if (submitButton) submitButton.disabled = false;
      })
      .finally(() => clearTimeout(timeout));
  });
</script>
