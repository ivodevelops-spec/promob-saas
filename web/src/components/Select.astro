---
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  options: Option[];
  name?: string;
  help?: string;
  error?: string;
  required?: boolean;
  value?: string;
}

const {
  id,
  label,
  options,
  name = id,
  help,
  error,
  required = false,
  value,
} = Astro.props;

const describedBy = error ? `${id}-error` : help ? `${id}-help` : undefined;
---

<div class="field">
  <label class="field__label" for={id}>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>
  <div class="field__select-wrap">
    <select
      class:list={[
        "field__control field__select",
        { "field__control--error": Boolean(error) },
      ]}
      id={id}
      name={name}
      required={required}
      value={value}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
    >
      {options.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
    <span class="field__chevron" aria-hidden="true"></span>
  </div>
  {
    error ? (
      <p class="field__message field__message--error" id={`${id}-error`}>
        {error}
      </p>
    ) : help ? (
      <p class="field__message" id={`${id}-help`}>{help}</p>
    ) : null
  }
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field__label {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--ink-700);
  }

  .field__select-wrap {
    position: relative;
  }

  .field__control {
    width: 100%;
    min-height: 44px;
    padding: 10px var(--space-4);
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    font-size: var(--text-body);
    color: var(--ink-900);
    transition: border-color 150ms ease;
  }

  .field__select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: var(--space-12);
    cursor: pointer;
  }

  .field__control:focus {
    outline: 2px solid var(--brand-700);
    outline-offset: 2px;
    border-color: var(--brand-700);
  }

  .field__control--error {
    border: 2px solid var(--danger-fg);
  }

  .field__control:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--brand-50);
  }

  .field__chevron {
    position: absolute;
    top: 50%;
    right: var(--space-4);
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-500);
    border-bottom: 2px solid var(--ink-500);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field__message {
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-500);
  }

  .field__message--error {
    color: var(--danger-fg);
  }
</style>
