---
// Plantilla única y sobria para las páginas legales: título + secciones con
// anclas. Los textos definitivos los provee y aprueba el cliente
// (PLAN-UX-UI-PROMOB.md §4.2); este contenido es provisorio.

import Layout from "../layouts/Layout.astro";
import Alert from "./Alert.astro";

interface Section {
  id: string;
  title: string;
  paragraphs: string[];
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  /** Título del documento (h1 de la página). */
  heading: string;
  updated: string;
  sections: Section[];
}

const { title, description, canonical, heading, updated, sections } =
  Astro.props;
---

<Layout title={title} description={description} canonical={canonical}>
  <section class="section">
    <div class="container legal">
      <h1>{heading}</h1>

      <Alert variant="info" title="Texto provisorio">
        Los textos legales definitivos serán provistos y aprobados por el
        cliente. Esta página es una vista previa y no constituye una versión
        final.
      </Alert>

      <p class="legal__updated">Última actualización: {updated}</p>

      <nav class="legal__toc" aria-label="Índice del documento">
        <p class="legal__toc-title">Índice</p>
        <ol class="legal__toc-list">
          {sections.map((section, index) => (
            <li>
              <a href={`#${section.id}`}>
                {index + 1}. {section.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="legal__body">
        {sections.map((section, index) => (
          <section aria-labelledby={`${section.id}-titulo`}>
            <h2 id={section.id} class="legal__heading">
              <span class="legal__num">{index + 1}.</span> {section.title}
            </h2>
            {section.paragraphs.map((paragraph) => (
              <p class="legal__paragraph">{paragraph}</p>
            ))}
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal {
    max-width: 760px;
  }

  .legal :global(.alert) {
    margin-top: var(--space-6);
  }

  .legal__updated {
    margin-top: var(--space-6);
    font-size: var(--text-micro);
    color: var(--ink-400);
  }

  .legal__toc {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .legal__toc-title {
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-900);
  }

  .legal__toc-list {
    margin-top: var(--space-2);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-body);
  }

  .legal__toc-list a {
    color: var(--brand-700);
    text-decoration: none;
  }

  .legal__toc-list a:hover {
    text-decoration: underline;
  }

  .legal__body {
    margin-top: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .legal__heading {
    margin-bottom: var(--space-3);
    font-size: var(--text-h3);
    color: var(--brand-900);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .legal__num {
    color: var(--accent-500);
  }

  .legal__paragraph {
    font-size: var(--text-body);
    line-height: var(--leading-body-lg);
    color: var(--ink-700);
  }

  .legal__paragraph + .legal__paragraph {
    margin-top: var(--space-3);
  }
</style>
