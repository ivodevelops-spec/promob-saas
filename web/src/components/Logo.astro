---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a class:list={["logo", className]} href="/" aria-label="promob — Inicio">
  <span class="logo__word">promob</span>
  <span class="logo__tagline">A <strong>Cyncly</strong> Company</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    border-radius: var(--radius-md);
    line-height: 1;
  }

  .logo__word {
    font-size: 24px;
    font-weight: var(--weight-extrabold);
    font-style: italic;
    letter-spacing: -0.5px;
    line-height: 1;
    color: var(--brand-900);
    white-space: nowrap;
  }

  .logo__tagline {
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--ink-500);
    white-space: nowrap;
  }

  .logo__tagline strong {
    color: var(--ink-700);
    font-weight: var(--weight-semibold);
  }
</style>
