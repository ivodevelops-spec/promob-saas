---
type CountryCode = "AR" | "UY" | "CL" | "PY";

interface Country {
  code: CountryCode;
  name: string;
  currency: string;
}

interface Props {
  countries: Country[];
  active?: CountryCode;
  class?: string;
}

const { countries, active, class: className } = Astro.props;
---

<div class:list={["chips", className]} role="group" aria-label="Selección de país">
  {countries.map((country) => (
    <button
      type="button"
      class:list={["chip", { "chip--active": country.code === active }]}
      aria-pressed={country.code === active ? "true" : "false"}
    >
      {
        country.code === "AR" && (
          <svg class="chip__flag" viewBox="0 0 20 14" aria-hidden="true">
            <rect width="20" height="14" rx="2" fill="#74acdf"></rect>
            <rect y="4.7" width="20" height="4.6" fill="#ffffff"></rect>
            <circle cx="10" cy="7" r="2.1" fill="#f6b40e"></circle>
          </svg>
        )
      }
      {
        country.code === "UY" && (
          <svg class="chip__flag" viewBox="0 0 20 14" aria-hidden="true">
            <rect width="20" height="14" rx="2" fill="#ffffff"></rect>
            <rect y="2" width="20" height="2" fill="#0038a8"></rect>
            <rect y="6" width="20" height="2" fill="#0038a8"></rect>
            <rect y="10" width="20" height="2" fill="#0038a8"></rect>
            <circle cx="6" cy="5" r="1.6" fill="#f6b40e"></circle>
          </svg>
        )
      }
      {
        country.code === "CL" && (
          <svg class="chip__flag" viewBox="0 0 20 14" aria-hidden="true">
            <rect width="20" height="14" rx="2" fill="#ffffff"></rect>
            <rect y="7" width="20" height="7" fill="#d52b1e"></rect>
            <rect width="8" height="7" fill="#0039a6"></rect>
            <polygon
              points="4,1.6 4.7,3.3 6.5,3.3 5.1,4.4 5.7,6.2 4,5.1 2.3,6.2 2.9,4.4 1.5,3.3 3.3,3.3"
              fill="#ffffff"
            ></polygon>
          </svg>
        )
      }
      {
        country.code === "PY" && (
          <svg class="chip__flag" viewBox="0 0 20 14" aria-hidden="true">
            <rect width="20" height="4.7" fill="#d52b1e"></rect>
            <rect y="4.7" width="20" height="4.6" fill="#ffffff"></rect>
            <rect y="9.3" width="20" height="4.7" fill="#0038a8"></rect>
            <circle cx="10" cy="7" r="2" fill="#f6b40e"></circle>
          </svg>
        )
      }
      <span class="chip__name">{country.name}</span>
      <span class="chip__currency">({country.currency})</span>
    </button>
  ))}
</div>

<style>
  .chips {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-block: var(--space-1);
    scrollbar-width: none;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    min-height: 40px;
    padding: 7px var(--space-4);
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--ink-600);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .chip:hover {
    background: var(--brand-50);
    border-color: var(--brand-700);
  }

  .chip--active,
  .chip--active:hover {
    background: var(--brand-700);
    border-color: var(--brand-700);
    color: var(--surface);
  }

  .chip__flag {
    width: 18px;
    height: 13px;
    flex-shrink: 0;
    border-radius: 2px;
  }

  .chip__currency {
    font-size: var(--text-micro);
    opacity: 0.8;
  }
</style>
