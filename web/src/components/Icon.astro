---
export type IconName =
  | "check"
  | "arrow-right"
  | "chevron-down"
  | "check-circle"
  | "info"
  | "alert-triangle"
  | "x-circle"
  | "whatsapp"
  | "instagram"
  | "youtube"
  | "facebook";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

{
  name === "check" && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  )
}
{
  name === "arrow-right" && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
