# ============================================================
# promob-saas — matriz de variables de entorno (valores placeholder)
# Copiar a `.env` y completar. `.env` está gitignoreado.
# ============================================================

# Supabase (Proyecto: crearlo en https://supabase.com)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_placeholder
SUPABASE_ANON_KEY=anon_placeholder

# MercadoPago (cuenta AR — https://www.mercadopago.com.ar/developers)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=webhook_secret_placeholder

# Resend (https://resend.com)
RESEND_API_KEY=re_placeholder
MAIL_FROM=Promob <noreply@example.com>

# Dueño del negocio (alertas)
OWNER_EMAIL=owner@example.com

# Sitio
SITE_URL=http://localhost:4321

# Secret para funciones programadas (cron)
CRON_SECRET=cron_secret_placeholder
